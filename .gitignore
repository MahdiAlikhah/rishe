/target
/.venv
__pycache__/
# Local build output: the editable install imports python/rishe/_core.pyd,
# so run `maturin develop` to recreate it after removing it.
*.pyd
*.pdb
*.so
/dist
/data/corpora/
/data/*.pdf

# Training outputs and model packs stay out of git.
/training/result/**/artifacts*/
/training/**/*.vec
/training/**/*.model
/training/**/sentences.txt
/training/**/*.zip

# pip and maturin scratch directories land in the working directory of the
# command that started them; keep them from showing up as untracked noise.
/pip-*/
/tmp*/
